NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL Supabase Connection
# Use Transaction Pooler (Port 6543) for serverless/Render deployments
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:6543/postgres?pgbouncer=true

# JWT Secrets (Generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=student-records
